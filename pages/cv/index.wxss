.cv-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.control-card,
.result-card,
.form-card,
.engineering-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.section-head,
.form-section-head,
.result-top,
.inline-label,
.engineering-toggle,
.control-footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-head {
  margin-bottom: 22rpx;
}

.section-eyebrow,
.section-title,
.section-subtitle,
.example-notice,
.result-eyebrow,
.result-label,
.form-title,
.form-title__en,
.engineering-title,
.engineering-en,
.error-summary__title,
.error-summary__item {
  display: block;
}

.section-eyebrow,
.result-eyebrow {
  margin-bottom: 8rpx;
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1.8rpx;
}

.section-title {
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-subtitle {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.example-button,
.reset-button,
.unit-button {
  flex: 0 0 auto;
  min-height: 54rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8d5cf;
  border-radius: 999rpx;
  color: var(--color-ink);
  font-size: 21rpx;
  font-weight: 700;
  background: transparent;
}

.example-button {
  min-height: 80rpx;
  border-radius: 14rpx;
}

.reset-button {
  min-height: 80rpx;
  border-radius: 14rpx;
}

.segment-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background: #f0efec;
}

.segment-group--media {
  margin-top: 12rpx;
}

.segment {
  display: flex;
  flex-direction: column;
  min-width: 0;
  width: 100%;
  height: 100%;
  min-height: 78rpx;
  gap: 6rpx;
  border: 1rpx solid transparent;
  border-radius: 13rpx;
  color: #686f78;
  font-size: 25rpx;
  font-weight: 750;
  background: #fafaf8;
}

.segment.active {
  color: #ffffff;
  border-color: var(--color-ink);
  background: var(--color-ink);
}

.segment--media {
  min-height: 72rpx;
  font-size: 22rpx;
}

.segment-group--media .segment.active {
  border-color: var(--color-brand);
  background: var(--color-brand);
}

.segment__en {
  font-size: 18rpx;
  letter-spacing: 1rpx;
  opacity: 0.68;
}

.unit-toolbar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
  padding: 10rpx;
  border-radius: 18rpx;
  background: var(--color-ink);
}

.unit-toolbar--liquid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.unit-control {
  flex-direction: column;
  align-items: stretch;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 80rpx;
  padding: 10rpx 8rpx;
  border-radius: 12rpx;
  color: #ffffff;
  text-align: center;
  background: #2a2a2a;
}

.unit-control__label,
.unit-control__value {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unit-control__label {
  color: #c1c5ca;
  font-size: 18rpx;
}

.unit-control__value {
  margin-top: 4rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.current-context {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: var(--color-muted);
  background: #f3f3f1;
}

.current-context__label,
.current-context__state {
  font-size: 19rpx;
}

.current-context__label {
  font-weight: 700;
}

.current-context__value {
  min-width: 0;
  overflow: hidden;
  color: var(--color-ink);
  font-size: 21rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.current-context__state {
  color: var(--color-muted);
  font-weight: 700;
}

.current-context__state.is-ready {
  color: var(--color-success);
}

.control-footer {
  align-items: center;
  min-height: 54rpx;
  margin-top: 16rpx;
}

.example-notice {
  color: #53616e;
  font-size: 20rpx;
}

.action-notice {
  display: block;
  margin-bottom: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 13rpx;
  color: var(--color-success);
  font-size: 22rpx;
  background: #eaf6ee;
}

.result-card {
  color: #ffffff;
  border-color: #202020;
  background: #1d1d1d;
  box-shadow: 0 18rpx 42rpx rgba(23, 23, 23, 0.14);
}

.result-card .result-eyebrow {
  color: #ff7779;
}

.result-card .result-label {
  color: #d8d8d8;
  font-size: 23rpx;
}

.result-value-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin: 24rpx 0;
}

.result-value {
  font-family: inherit;
  font-size: 66rpx;
  font-weight: 850;
  line-height: 1;
}

.result-unit {
  color: #c0c0c0;
  font-size: 24rpx;
}

.result-meta {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.result-meta__item {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  min-width: 0;
  padding: 14rpx;
  border-radius: 13rpx;
  color: #d7d7d7;
  font-size: 20rpx;
  background: #2a2a2a;
}

.result-meta__label {
  color: #8f8f8f;
  font-size: 17rpx;
}

.result-meta__item--media {
  grid-column: 1 / -1;
  border: 1rpx solid rgba(255, 91, 94, 0.38);
  background: #352426;
}

.result-meta__item--wide {
  grid-column: 1 / -1;
}

.result-meta__item--media.is-highlighted {
  border-color: #ff7779;
  box-shadow: 0 0 0 4rpx rgba(255, 119, 121, 0.12);
}

.result-media-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.result-media-type {
  flex: 0 0 auto;
  padding: 4rpx 8rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 15rpx;
  background: rgba(255, 255, 255, 0.12);
}

.form-section-head {
  align-items: center;
  margin-bottom: 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #eceae6;
}

.form-title {
  color: var(--color-ink);
  font-size: 28rpx;
  font-weight: 800;
}

.form-title__en {
  margin-top: 4rpx;
  color: #8a9098;
  font-size: 18rpx;
  letter-spacing: 0.8rpx;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 14rpx;
}

.field-grid__wide {
  grid-column: 1 / -1;
}

.input-with-unit {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 86rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border: 1rpx solid #d4d2cd;
  border-radius: 16rpx;
  background: #fbfbfa;
}

.field-input {
  min-width: 0;
  height: 84rpx;
  padding: 0 8rpx 0 20rpx;
  flex: 1;
  color: var(--color-ink);
  font-size: 28rpx;
}

.field-unit {
  flex: 0 0 auto;
  max-width: 170rpx;
  padding: 0 18rpx;
  color: #6c737c;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
}

.picker-field {
  justify-content: space-between;
  width: 100%;
  min-height: 86rpx;
  margin-top: 12rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d4d2cd;
  border-radius: 16rpx;
  color: var(--color-ink);
  font-size: 25rpx;
  font-weight: 650;
  background: #fbfbfa;
}

.inline-label {
  align-items: center;
}

.error-summary {
  margin-bottom: 22rpx;
  padding: 20rpx;
  border: 1rpx solid #efb7b8;
  border-radius: 18rpx;
  color: var(--color-danger);
  background: #fff1f1;
}

.error-summary__title {
  margin-bottom: 8rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.error-summary__item {
  font-size: 21rpx;
  line-height: 1.55;
}

.engineering-toggle {
  width: 100%;
  align-items: center;
  color: var(--color-ink);
  text-align: left;
  background: transparent;
}

.engineering-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 800;
}

.engineering-en {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

@media (min-width: 900px) {
  .form-card {
    padding-right: 36rpx;
    padding-left: 36rpx;
  }
}
