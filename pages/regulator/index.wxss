.regulator-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.intro-card,
.result-card,
.group-card,
.engineering-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.section-head,
.intro-footer,
.result-head,
.group-head,
.engineering-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-head {
  margin-bottom: 20rpx;
}

.section-eyebrow,
.section-title,
.section-subtitle,
.example-notice,
.auto-notice,
.action-notice,
.result-eyebrow,
.result-title,
.model-label,
.spec-label,
.spec-value,
.result-note,
.error-title,
.error-item,
.group-title,
.group-en,
.engineering-title,
.engineering-en {
  display: block;
}

.section-eyebrow,
.result-eyebrow {
  margin-bottom: 8rpx;
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1.8rpx;
}

.section-title {
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-subtitle {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.example-button,
.reset-button,
.details-toggle {
  flex: 0 0 auto;
  min-height: 54rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8d5cf;
  border-radius: 999rpx;
  color: var(--color-ink);
  font-size: 21rpx;
  font-weight: 700;
  background: transparent;
}

.example-button {
  min-height: 80rpx;
  border-radius: 14rpx;
}

.reset-button {
  min-height: 80rpx;
  border-radius: 14rpx;
}

.intro-footer {
  align-items: center;
  min-height: 54rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eceae6;
}

.selection-progress {
  margin-bottom: 16rpx;
}

.selection-progress__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  font-weight: 700;
}

.selection-progress__track {
  height: 8rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e9e7e2;
}

.selection-progress__bar {
  height: 100%;
  border-radius: inherit;
  background: var(--color-brand);
  transition: width 160ms ease;
}

.example-notice,
.auto-notice {
  color: #6f7680;
  font-size: 20rpx;
}

.action-notices {
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  color: var(--color-warning);
  background: #fff4dc;
}

.action-notice {
  font-size: 21rpx;
  line-height: 1.55;
}

.result-head {
  align-items: center;
  margin-bottom: 20rpx;
}

.result-title {
  color: var(--color-ink);
  font-size: 30rpx;
  font-weight: 800;
}

.model-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  width: 100%;
  min-height: 126rpx;
  padding: 20rpx;
  gap: 18rpx;
  border: 1rpx solid #d9d6d0;
  border-radius: 18rpx;
  text-align: left;
  background: #fafaf8;
}

.model-card > view {
  width: 100%;
  min-width: 0;
}

.model-card.model-card--button {
  align-self: stretch;
  width: 100%;
  max-width: 100%;
  margin: 0;
}

.model-card--warning {
  border-color: #eed69f;
  background: #fff8e8;
}

.model-card--pressed {
  transform: scale(0.99);
}

.model-label {
  margin-bottom: 8rpx;
  color: #7b818a;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.result-code {
  font-size: 30rpx;
  overflow-x: visible;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.regulator-page .ui-result-code {
  font-family: inherit;
}

.copy-action {
  align-self: flex-end;
  color: var(--color-brand);
  font-size: 22rpx;
  font-weight: 800;
}

.copy-action--warning,
.model-card--warning .model-label {
  color: #a66b00;
}

.spec-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.spec-grid--more {
  margin-top: 12rpx;
}

.spec-item {
  min-width: 0;
  padding: 15rpx;
  border-radius: 13rpx;
  background: #f6f6f4;
}

.spec-label {
  color: #838991;
  font-size: 19rpx;
}

.spec-value {
  margin-top: 5rpx;
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
}

.details-toggle {
  justify-content: flex-start;
  margin-top: 16rpx;
  padding-left: 0;
  border: 0;
  color: #68707a;
}

.result-note {
  margin-top: 16rpx;
  padding: 15rpx;
  border-radius: 13rpx;
  color: var(--color-warning);
  font-size: 21rpx;
  line-height: 1.5;
  background: #fff4dc;
}

.error-card {
  margin-bottom: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #efb7b8;
  border-radius: 18rpx;
  color: var(--color-danger);
  background: #fff1f1;
}

.error-title {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.error-item {
  font-size: 20rpx;
  line-height: 1.5;
}

.group-head {
  align-items: center;
  margin-bottom: 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #eceae6;
}

.group-title {
  color: var(--color-ink);
  font-size: 29rpx;
  font-weight: 800;
}

.group-en {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  letter-spacing: 0.8rpx;
}

.group-number {
  color: #c6c3bd;
  font-family: inherit;
  font-size: 25rpx;
  font-weight: 800;
}

.group-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22rpx 14rpx;
}

.field-block {
  min-width: 0;
}

.field-block--segmented {
  grid-column: 1 / -1;
}

.choice-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 12rpx;
}

.choice-button {
  min-width: 0;
  min-height: 80rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid #d9d6d0;
  border-radius: 13rpx;
  color: #626a74;
  font-size: 20rpx;
  line-height: 1.3;
  white-space: normal;
  overflow-wrap: anywhere;
  background: #fafaf8;
}

.choice-button.active {
  color: #ffffff;
  border-color: var(--color-brand);
  background: var(--color-brand);
}

.picker-field,
.input-with-unit {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 82rpx;
  margin-top: 12rpx;
  border: 1rpx solid #d4d2cd;
  border-radius: 15rpx;
  background: #fbfbfa;
}

.picker-field {
  justify-content: space-between;
  min-width: 0;
  padding: 14rpx 18rpx;
  color: var(--color-ink);
  font-size: 22rpx;
  line-height: 1.35;
  text-align: left;
}

.picker-field text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.picker-field.placeholder,
.picker-field.disabled {
  color: #969ba2;
}

.picker-field.disabled {
  border-color: #e3e1dc;
  background: #f0f0ee;
}

.field-input {
  min-width: 0;
  height: 80rpx;
  padding: 0 8rpx 0 18rpx;
  flex: 1;
  color: var(--color-ink);
  font-size: 27rpx;
}

.field-unit {
  flex: 0 0 auto;
  padding: 0 18rpx;
  color: #6c737c;
  font-size: 20rpx;
  font-weight: 700;
}

.engineering-toggle {
  width: 100%;
  align-items: center;
  color: var(--color-ink);
  text-align: left;
  background: transparent;
}

.engineering-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 800;
}

.engineering-en {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  letter-spacing: 0.8rpx;
}

@media (max-width: 360px) {
  .group-fields,
  .spec-grid {
    grid-template-columns: 1fr;
  }
}
