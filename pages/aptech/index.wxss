.aptech-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.workspace-card,
.summary-card,
.result-card,
.engineering-card {
  padding: 24rpx;
}

.workspace-card,
.summary-card,
.engineering-card {
  margin-bottom: 18rpx;
}

.section-head,
.summary-head,
.result-head,
.candidate-head,
.engineering-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-head,
.summary-head {
  margin-bottom: 24rpx;
}

.section-eyebrow,
.section-title,
.section-subtitle,
.example-notice,
.stale-notice,
.copy-rule,
.source-label,
.match-status,
.candidate-label,
.review-note__title,
.review-note__copy,
.mapping-label,
.missing-state__title,
.missing-state__copy,
.engineering-title,
.engineering-en {
  display: block;
}

.section-eyebrow {
  margin-bottom: 8rpx;
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1.8rpx;
}

.section-title {
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-subtitle {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.example-button {
  flex: 0 0 auto;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8d5cf;
  border-radius: 14rpx;
  color: var(--color-ink);
  font-size: 22rpx;
  font-weight: 700;
  background: transparent;
}

.example-notice,
.stale-notice {
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  line-height: 1.4;
}

.example-notice {
  color: #53616e;
  background: #f0f2f3;
}

.stale-notice {
  color: var(--color-warning);
  background: #fff4dc;
}

.model-textarea {
  width: 100%;
  min-height: 270rpx;
  padding: 22rpx;
  border: 1rpx solid #d6d3cd;
  border-radius: 18rpx;
  color: var(--color-ink);
  font-family: inherit;
  font-size: 27rpx;
  line-height: 1.65;
  background: #fafaf8;
}

.submit-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.submit-button,
.reset-button {
  width: 100%;
}

.summary-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 58rpx;
  height: 58rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  color: var(--color-brand);
  font-size: 27rpx;
  font-weight: 800;
  background: #fff0f0;
}

.summary-filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin: 4rpx 0 20rpx;
}

.summary-filter {
  width: 100%;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dedbd5;
  border-radius: 14rpx;
  color: #5d646d;
  font-size: 22rpx;
  font-weight: 700;
  background: #ffffff;
}

.summary-filter.active {
  color: #ffffff;
  border-color: var(--color-ink);
  background: var(--color-ink);
}

.summary-filter--success.active {
  border-color: var(--color-success);
  background: var(--color-success);
}

.summary-filter--warning.active {
  border-color: var(--color-warning);
  background: var(--color-warning);
}

.summary-filter--neutral.active {
  border-color: #626a74;
  background: #626a74;
}

.copy-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.copy-button {
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d9d6d0;
  border-radius: 14rpx;
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 750;
  background: #ffffff;
}

.copy-button--primary {
  color: #ffffff;
  border-color: var(--color-brand);
  background: var(--color-brand);
}

.copy-button[disabled] {
  opacity: 0.42;
}

.copy-rule {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.result-card {
  position: relative;
  overflow: hidden;
}

.result-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  content: "";
  background: #a4a9b0;
}

.result-card--exact::before {
  background: var(--color-success);
}

.result-card--candidate::before {
  background: #d99400;
}

.result-head {
  align-items: center;
}

.source-block,
.candidate-main {
  min-width: 0;
  flex: 1;
}

.source-label,
.candidate-label,
.mapping-label {
  margin-bottom: 7rpx;
  color: #7b818a;
  font-size: 19rpx;
  font-weight: 750;
  letter-spacing: 0.6rpx;
}

.source-model,
.candidate-model {
  max-width: 100%;
  color: var(--color-ink);
  font-family: inherit;
  font-weight: 800;
  white-space: nowrap;
}

.aptech-page .ui-result-code {
  font-family: inherit;
}

.source-model {
  font-size: 28rpx;
}

.match-status {
  margin: 14rpx 0 18rpx;
  color: #6d747e;
  font-size: 21rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.candidate-row + .candidate-row {
  padding-top: 20rpx;
  border-top: 1rpx solid #eceae6;
}

.candidate-head {
  align-items: center;
  margin-bottom: 14rpx;
}

.candidate-model {
  font-size: 24rpx;
}

.candidate-detail {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 4rpx;
  color: #737a83;
}

.candidate-detail__label {
  flex: 0 0 auto;
  font-size: 19rpx;
}

.candidate-score {
  flex: 0 0 auto;
  color: #787f88;
  font-size: 20rpx;
  font-weight: 700;
}

.candidate-score--verified {
  color: var(--color-success);
}

.candidate-score--review {
  color: var(--color-warning);
}

.mapping-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  width: 100%;
  min-height: 114rpx;
  padding: 20rpx;
  gap: 18rpx;
  border: 1rpx solid #b8dfc7;
  border-radius: 17rpx;
  text-align: left;
  background: #eef9f2;
}

.mapping-card > view {
  min-width: 0;
  width: 100%;
}

.mapping-card.mapping-card--button {
  align-self: stretch;
  width: 100%;
  max-width: 100%;
  margin: 0;
}

.mapping-stack {
  flex-direction: column;
  align-items: stretch;
  min-height: 100rpx;
  padding: 12rpx 16rpx;
  gap: 6rpx;
  border-radius: 14rpx;
}

.mapping-relation {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #626a74;
  font-size: 19rpx;
  font-weight: 750;
  white-space: nowrap;
}

.mapping-relation text:last-child {
  color: #7b818a;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.mapping-model-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  gap: 12rpx;
}

.mapping-target {
  min-width: 0;
  flex: 1;
}

.mapping-stack .ui-result-code {
  font-size: 27rpx;
}

.mapping-card--warning {
  border-color: #eed69f;
  background: #fff8e8;
}

.mapping-card--empty {
  display: block;
  min-height: 96rpx;
  border-color: #e0ded9;
  color: #777d85;
  background: #f6f6f4;
}

.mapping-card--pressed {
  transform: scale(0.99);
}

.mapping-action {
  align-self: flex-end;
  flex: 0 0 auto;
  color: var(--color-brand);
  font-size: 21rpx;
  font-weight: 800;
}

.mapping-action--locked {
  color: var(--color-warning);
}

.empty-model {
  color: #777e87;
  font-size: 23rpx;
}

.review-note {
  margin-top: 13rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  color: var(--color-warning);
  background: #fff4dc;
}

.review-note__title {
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 0.8rpx;
}

.review-note__copy {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.5;
}

.missing-state {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f3f3f1;
}

.missing-state__title {
  color: #454b53;
  font-size: 25rpx;
  font-weight: 750;
}

.missing-state__copy {
  margin-top: 7rpx;
  color: #7b8189;
  font-size: 21rpx;
}

.engineering-toggle {
  width: 100%;
  align-items: center;
  color: var(--color-ink);
  text-align: left;
  background: transparent;
}

.engineering-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 800;
}

.engineering-en {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

@media (min-width: 900px) {
  .result-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
