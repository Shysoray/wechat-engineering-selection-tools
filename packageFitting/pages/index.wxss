.fitting-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.mode-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  margin: 12rpx 0 24rpx;
  padding: 8rpx;
  border-radius: 20rpx;
  box-shadow: none;
}

.mode-option {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 80rpx;
  gap: 7rpx;
  border-radius: 14rpx;
  color: #747a83;
  font-size: 27rpx;
  font-weight: 700;
  background: transparent;
}

.mode-option.active {
  color: #ffffff;
  background: var(--color-ink);
}

.mode-option__en {
  font-size: 20rpx;
  font-weight: 650;
  letter-spacing: 1.2rpx;
  opacity: 0.7;
}

.workspace-card,
.summary-card,
.validation-item,
.result-card,
.engineering-card {
  padding: 24rpx;
}

.workspace-card,
.summary-card,
.engineering-card {
  margin-bottom: 18rpx;
}

.section-head,
.summary-head,
.validation-item__head,
.candidate-source,
.engineering-toggle {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-head,
.summary-head {
  margin-bottom: 24rpx;
}

.section-eyebrow,
.section-title,
.section-subtitle,
.source-label,
.candidate-brand,
.mapping-label,
.warning-text,
.missing-state__title,
.missing-state__copy,
.engineering-title,
.engineering-en,
.spec-label,
.spec-value,
.product-name,
.result-note,
.copy-rule,
.example-notice,
.stale-notice {
  display: block;
}

.section-eyebrow {
  margin-bottom: 8rpx;
  color: var(--color-brand);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 1.8rpx;
}

.section-title {
  color: var(--color-ink);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-subtitle {
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.example-button,
.details-toggle,
.engineering-toggle {
  color: var(--color-ink);
  background: transparent;
}

.example-button {
  flex: 0 0 auto;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d8d5cf;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.example-notice,
.stale-notice {
  margin-bottom: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  line-height: 1.4;
}

.example-notice {
  color: #53616e;
  background: #f0f2f3;
}

.stale-notice {
  color: var(--color-warning);
  background: #fff4dc;
}

.model-textarea {
  width: 100%;
  min-height: 270rpx;
  padding: 22rpx;
  border: 1rpx solid #d6d3cd;
  border-radius: 18rpx;
  color: var(--color-ink);
  font-family: inherit;
  font-size: 27rpx;
  line-height: 1.65;
  background: #fafaf8;
}

.submit-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.submit-button,
.reset-button {
  width: 100%;
}

.batch-result-anchor {
  scroll-margin-top: 24rpx;
}

.summary-count,
.result-count {
  color: var(--color-brand);
  font-size: 27rpx;
  font-weight: 800;
}

.summary-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 58rpx;
  height: 58rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: #fff0f0;
}

.summary-filters {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin: 4rpx 0 20rpx;
}

.summary-filter {
  width: 100%;
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dedbd5;
  border-radius: 14rpx;
  color: #5d646d;
  font-size: 22rpx;
  font-weight: 700;
  background: #ffffff;
}

.summary-filter.active {
  color: #ffffff;
  border-color: var(--color-ink);
  background: var(--color-ink);
}

.summary-filter--success.active {
  border-color: var(--color-success);
  background: var(--color-success);
}

.summary-filter--warning.active {
  border-color: var(--color-warning);
  background: var(--color-warning);
}

.summary-filter--neutral.active {
  border-color: #626a74;
  background: #626a74;
}

.copy-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.copy-button {
  min-height: 80rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d9d6d0;
  border-radius: 14rpx;
  color: var(--color-ink);
  font-size: 24rpx;
  font-weight: 750;
  background: #ffffff;
}

.copy-button--primary {
  color: #ffffff;
  border-color: var(--color-brand);
  background: var(--color-brand);
}

.copy-rule {
  margin-top: 14rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.45;
}

.validation-results,
.result-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.validation-item,
.result-card {
  position: relative;
  overflow: hidden;
}

.validation-item::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  content: "";
  background: #a4a9b0;
}

.validation-item--exact::before {
  background: var(--color-success);
}

.validation-item--candidate::before {
  background: #d99400;
}

.validation-item__head {
  align-items: center;
  margin-bottom: 22rpx;
}

.source-block {
  min-width: 0;
  flex: 1;
}

.source-label,
.candidate-brand,
.mapping-label {
  margin-bottom: 7rpx;
  color: #7b818a;
  font-size: 19rpx;
  font-weight: 750;
  letter-spacing: 0.6rpx;
}

.source-code,
.candidate-code {
  max-width: 100%;
  color: var(--color-ink);
  font-family: inherit;
  font-weight: 800;
  white-space: nowrap;
}

.fitting-page .ui-result-code {
  font-family: inherit;
}

.source-code {
  font-size: 28rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.candidate-list,
.candidate-row {
  width: 100%;
  min-width: 0;
}

.candidate-row + .candidate-row {
  padding-top: 20rpx;
  border-top: 1rpx solid #eceae6;
}

.candidate-source {
  align-items: center;
  margin-bottom: 14rpx;
}

.candidate-source > view {
  min-width: 0;
  flex: 1;
}

.candidate-source__main {
  min-width: 0;
}

.candidate-detail {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 4rpx;
  color: #737a83;
}

.candidate-detail__label {
  flex: 0 0 auto;
  font-size: 19rpx;
}

.candidate-code {
  font-size: 24rpx;
}

.similarity {
  flex: 0 0 auto;
  color: #787f88;
  font-size: 21rpx;
  font-weight: 700;
}

.mapping-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  width: 100%;
  min-height: 114rpx;
  padding: 20rpx;
  gap: 18rpx;
  border: 1rpx solid #b8dfc7;
  border-radius: 17rpx;
  text-align: left;
  background: #eef9f2;
}

.mapping-card.mapping-card--button {
  align-self: stretch;
  width: 100%;
  max-width: 100%;
  margin: 0;
}

.mapping-stack {
  flex-direction: column;
  align-items: stretch;
  min-height: 100rpx;
  padding: 12rpx 16rpx;
  gap: 6rpx;
  border-radius: 14rpx;
}

.mapping-relation {
  display: flex;
  align-items: center;
  gap: 7rpx;
  color: #626a74;
  font-size: 19rpx;
  font-weight: 750;
  white-space: nowrap;
}

.mapping-relation text:last-child {
  color: #7b818a;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.mapping-model-row {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 0;
  gap: 12rpx;
}

.mapping-target {
  min-width: 0;
  flex: 1;
}

.mapping-stack .ui-result-code {
  font-size: 27rpx;
}

.mapping-card__content {
  width: 100%;
  min-width: 0;
}

.mapping-card--warning {
  border-color: #eed69f;
  background: #fff8e8;
}

.mapping-card--empty {
  min-height: 96rpx;
  border-color: #e0ded9;
  color: #777d85;
  background: #f6f6f4;
}

.mapping-card--pressed {
  transform: scale(0.99);
}

.mapping-action {
  align-self: flex-end;
  color: var(--color-brand);
  font-size: 21rpx;
  font-weight: 800;
}

.mapping-action--warning,
.mapping-action--locked {
  color: #a66b00;
}

.empty-model {
  color: #777e87;
  font-size: 23rpx;
}

.dimension-comparison {
  margin-top: 13rpx;
  padding: 15rpx 16rpx;
  border: 1rpx solid #cfe4d6;
  border-radius: 14rpx;
  background: #f4faf6;
}

.dimension-comparison--warning {
  border-color: #eed69f;
  background: #fff9ec;
}

.dimension-comparison__head,
.dimension-row__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.dimension-comparison__head {
  margin-bottom: 9rpx;
}

.dimension-comparison__title,
.dimension-comparison__summary,
.dimension-comparison__missing,
.dimension-comparison__evidence,
.dimension-row__label,
.dimension-row__values,
.dimension-row__delta {
  display: block;
}

.dimension-comparison__title {
  color: #68717a;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.dimension-comparison__summary {
  flex: 0 0 auto;
  color: var(--color-success);
  font-size: 18rpx;
  font-weight: 750;
}

.dimension-comparison--warning .dimension-comparison__summary {
  color: #a66b00;
}

.dimension-comparison__missing {
  margin: 4rpx 0 8rpx;
  color: #7c5a16;
  font-size: 20rpx;
  line-height: 1.5;
}

.dimension-comparison__evidence {
  margin-top: 8rpx;
  color: #737b84;
  font-size: 17rpx;
  line-height: 1.45;
}

.dimension-row {
  padding: 9rpx 0;
  border-top: 1rpx solid rgba(85, 103, 91, 0.11);
}

.dimension-row__label {
  flex: 0 0 auto;
  color: #525b64;
  font-size: 20rpx;
  font-weight: 750;
}

.dimension-row__values {
  min-width: 0;
  color: #68717a;
  font-size: 19rpx;
  text-align: right;
}

.dimension-row__delta {
  margin-top: 4rpx;
  color: var(--color-success);
  font-size: 19rpx;
  line-height: 1.45;
  text-align: right;
}

.dimension-row--warning .dimension-row__delta {
  color: #a66b00;
  font-weight: 750;
}

.warning-list {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  margin-top: 13rpx;
}

.warning-text {
  padding-left: 18rpx;
  color: #6f7680;
  font-size: 21rpx;
  line-height: 1.5;
}

.warning-text::before {
  margin-left: -18rpx;
  margin-right: 8rpx;
  content: "•";
}

.warning-text--warning,
.warning-text--danger {
  color: var(--color-warning);
}

.missing-state {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f3f3f1;
}

.missing-state__title {
  color: #454b53;
  font-size: 25rpx;
  font-weight: 750;
}

.missing-state__copy {
  margin-top: 7rpx;
  color: #7b8189;
  font-size: 21rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.picker-field {
  display: block;
  min-width: 0;
  min-height: 132rpx;
  padding: 19rpx;
  border: 1rpx solid #dedbd5;
  border-radius: 16rpx;
  text-align: left;
  background: #fafaf8;
}

.picker-field--wide {
  grid-column: 1 / -1;
}

.picker-field.picker-field--wide {
  width: 100%;
  max-width: 100%;
  margin: 0;
}

.picker-field--disabled {
  color: var(--color-muted);
  background: #f2f2ef;
  opacity: 0.72;
}

.picker-field__value {
  display: block;
  width: 100%;
  margin-top: 13rpx;
  overflow: hidden;
  color: var(--color-ink);
  font-size: 25rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-field__value.placeholder {
  color: #9b9fa5;
  font-weight: 500;
}

.select-reset {
  width: 100%;
  margin-top: 18rpx;
}

.select-reset.ui-button-secondary {
  width: 100%;
  max-width: 100%;
  margin: 18rpx 0 0;
}

.details-toggle {
  justify-content: flex-start;
  min-height: 68rpx;
  margin-top: 12rpx;
  color: #626a74;
  font-size: 22rpx;
  font-weight: 700;
}

.spec-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #eceae6;
}

.spec-item {
  min-width: 0;
  padding: 15rpx;
  border-radius: 13rpx;
  background: #f6f6f4;
}

.spec-label {
  color: #838991;
  font-size: 19rpx;
}

.spec-value {
  margin-top: 5rpx;
  color: var(--color-ink);
  font-size: 23rpx;
  font-weight: 700;
}

.product-name,
.result-note {
  grid-column: 1 / -1;
  color: #68707a;
  font-size: 21rpx;
  line-height: 1.55;
}

.engineering-toggle {
  width: 100%;
  align-items: center;
  text-align: left;
}

.engineering-title {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 800;
}

.engineering-en {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

@media (min-width: 900px) {
  .validation-results,
  .result-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
