page {
  --color-brand: #ed2b2e;
  --color-brand-pressed: #d51f22;
  --color-ink: #171717;
  --color-muted: #68707c;
  --color-canvas: #f3f2ef;
  --color-surface: #ffffff;
  --color-success: #197a45;
  --color-warning: #9a6100;
  --color-danger: #9f1d20;
  --color-border: #e4e2dd;
  --radius-control: 16rpx;
  --radius-card: 24rpx;
  --shadow-card: 0 14rpx 36rpx rgba(23, 23, 23, 0.07);
  min-height: 100%;
  background: var(--color-canvas);
  color: var(--color-ink);
  font-family: -apple-system, BlinkMacSystemFont, "HarmonyOS Sans SC", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
input,
textarea,
picker,
button {
  box-sizing: border-box;
}

button {
  min-width: 0;
  max-width: 100%;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

image {
  display: block;
}

.ui-page {
  min-height: 100vh;
  padding: 0 28rpx 40rpx;
}

.ui-card {
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  background: var(--color-surface);
  box-shadow: var(--shadow-card);
}

.ui-button-primary,
.ui-button-secondary,
.ui-button-quiet {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-control);
  font-size: 28rpx;
  font-weight: 700;
  transition: transform 140ms ease, background-color 140ms ease;
}

.ui-button-primary {
  color: #ffffff;
  background: var(--color-brand);
}

.ui-button-primary-pressed {
  background: var(--color-brand-pressed);
  transform: scale(0.985);
}

.ui-button-secondary {
  color: var(--color-ink);
  border: 1rpx solid #d7d4ce;
  background: #ffffff;
}

.ui-button-quiet {
  min-height: 80rpx;
  color: var(--color-muted);
  background: transparent;
}

.ui-field {
  margin-bottom: 24rpx;
}

.ui-label-cn,
.ui-label-en {
  display: block;
}

.ui-label-cn {
  color: var(--color-ink);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.ui-label-en {
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.25;
}

.ui-input {
  width: 100%;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #d4d2cd;
  border-radius: var(--radius-control);
  color: var(--color-ink);
  font-size: 29rpx;
  background: #fbfbfa;
}

.ui-field-error {
  display: block;
  margin-top: 8rpx;
  color: var(--color-danger);
  font-size: 22rpx;
  line-height: 1.4;
}

.ui-status {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.ui-status-success {
  color: var(--color-success);
  background: #e7f6ec;
}

.ui-status-warning {
  color: var(--color-warning);
  background: #fff3d7;
}

.ui-status-neutral {
  color: #5e6671;
  background: #eef0f2;
}

.ui-status-danger {
  color: var(--color-danger);
  border: 1rpx solid #efb7b8;
  background: #fff1f1;
}

.ui-result-code {
  display: block;
  max-width: 100%;
  overflow-x: auto;
  color: var(--color-ink);
  font-family: inherit;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  white-space: nowrap;
}

.ui-engineering-note {
  display: block;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eceae6;
  color: var(--color-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.engineering-toggle > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.engineering-title {
  line-height: 1.25;
}

.engineering-en {
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.25;
}

.engineering-toggle > text:last-child {
  flex: 0 0 auto;
  margin-left: 20rpx;
  font-size: 32rpx;
  line-height: 1;
}

@media (min-width: 900px) {
  .ui-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding-right: 40rpx;
    padding-left: 40rpx;
  }
}

@media (max-width: 360px) {
  .ui-page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }
}
