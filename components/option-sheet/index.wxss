.option-sheet__mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(12, 12, 12, 0.46);
  animation: mask-in 150ms ease both;
}

.option-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  animation: sheet-in 180ms ease both;
}

.option-sheet__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.option-sheet__title,
.option-sheet__subtitle {
  display: block;
}

.option-sheet__title {
  color: #171717;
  font-size: 32rpx;
  font-weight: 800;
}

.option-sheet__subtitle {
  margin-top: 5rpx;
  color: #8a9099;
  font-size: 20rpx;
}

.option-sheet__close {
  min-width: 88rpx;
  height: 56rpx;
  color: #68707c;
  font-size: 24rpx;
  background: #f1f1ef;
  border-radius: 999rpx;
}

.option-sheet__search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 82rpx;
  margin-top: 24rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8d6d1;
  border-radius: 16rpx;
  background: #fafaf9;
}

.option-sheet__search-icon {
  color: #68707c;
  font-size: 34rpx;
}

.option-sheet__search input {
  flex: 1;
  height: 82rpx;
  color: #171717;
  font-size: 27rpx;
}

.option-sheet__list {
  max-height: 52vh;
  margin-top: 16rpx;
}

.option-sheet__option {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  padding: 0 18rpx;
  border-bottom: 1rpx solid #efeeeb;
  color: #171717;
  font-size: 27rpx;
}

.option-sheet__option:active {
  color: #ed2b2e;
  background: #fff5f5;
}

.option-sheet__empty {
  padding: 52rpx 0;
  color: #8a9099;
  font-size: 25rpx;
  text-align: center;
}

@keyframes mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes sheet-in {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}
