.app-header {
  position: relative;
  z-index: 20;
  margin: 0 -28rpx 24rpx;
  padding-right: 190rpx;
  padding-left: 28rpx;
  background: rgba(243, 242, 239, 0.96);
}

.app-header__main {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  gap: 14rpx;
}

.app-header__back {
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  color: #171717;
  font-size: 48rpx;
  font-weight: 400;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(23, 23, 23, 0.08);
}

.app-header__logo {
  flex: 0 0 auto;
  width: 132rpx;
}

.app-header__titles {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  min-height: 60rpx;
  padding-top: 2rpx;
}

.app-header__title,
.app-header__subtitle {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-header__title {
  color: #171717;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.15;
}

.app-header__subtitle {
  margin-top: 3rpx;
  color: var(--color-muted);
  font-size: 20rpx;
  line-height: 1.2;
}

@media (max-width: 360px) {
  .app-header {
    margin-right: -22rpx;
    margin-left: -22rpx;
    padding-left: 22rpx;
  }
}
